FRESHDESK_DOMAIN=yourcompany          # subdomain only
FRESHDESK_API_KEY=                    # Profile Settings > API Key (use a dedicated read-only agent)
FRESHDESK_CALLS_PER_MINUTE=40         # sustained rate; keep ~80% of your plan quota
FRESHDESK_BURST=10                    # burst + rate must stay <= plan quota per minute
FRESHDESK_REDACT_PII=1                # 0 disables email/phone masking
